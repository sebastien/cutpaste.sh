#!/usr/bin/env bash
set -euo pipefail

CUTPASTE_SEP="--8<--"
CUTPASTE_VERSION="dev"

cutpaste_usage() {
	cat <<'EOF'
Usage:
  cutpaste list PATH [BLOCKISH...]
  cutpaste get PATH BLOCK
  cutpaste set PATH BLOCK [VALUE]
  cutpaste cut PATH [BLOCKISH...]
  cutpaste strip PATH [BLOCKISH...]
  cutpaste help
  cutpaste --version

Options:
  -h, --help
  -w, --overwrite   overwrite the input file for set/cut/strip
  -d, --dry         show a unified diff instead of writing or printing content
EOF
}

cutpaste_fail() {
	printf '%s\n' "$*" >&2
	exit 1
}

cutpaste_read_lines() {
	local path="$1"
	local -n _out="$2"
	_out=()
	if [ "$path" = "-" ]; then
		mapfile -t _out
		return 0
	fi
	if [ ! -e "$path" ]; then
		return 1
	fi
	mapfile -t _out <"$path"
}

cutpaste_read_value_lines() {
	local value="$1"
	local -n _out="$2"
	_out=()
	if [ -z "$value" ]; then
		return 0
	fi
	mapfile -t _out < <(printf '%s' "$value")
}

cutpaste_lines_to_text() {
	local -n _lines="$1"
	printf '%s\n' "${_lines[@]}"
}

cutpaste_write_overwrite() {
	local path="$1"
	local text_path="$2"

	if [ "$path" = "-" ]; then
		cutpaste_fail "cutpaste: cannot overwrite stdin"
	fi

	cat "$text_path" >"$path"
}

cutpaste_show_diff() {
	local path="$1"
	local original_path="$2"
	local result_path="$3"

	if ! diff -u --label "${path} (original)" --label "${path} (updated)" "$original_path" "$result_path"; then
		return 0
	fi
}

cutpaste_parse_separator() {
	local line="$1"
	local -n _kind="$2"
	local -n _name="$3"
	local re='^[[:space:][:punct:]]*-{2,}8<-{2,}[[:space:]]+(START|END):([A-Za-z0-9._-]+)[[:space:]]*$'

	if [[ $line =~ $re ]]; then
		_kind="${BASH_REMATCH[1]}"
		_name="${BASH_REMATCH[2]}"
		return 0
	fi

	return 1
}

cutpaste_blockish_match() {
	local name="$1"
	shift

	if [ "$#" -eq 0 ]; then
		return 0
	fi

	local pattern
	for pattern in "$@"; do
		if [[ $name == $pattern ]]; then
			return 0
		fi
	done

	return 1
}

cutpaste_find_block_end() {
	local -n _lines="$1"
	local start_idx="$2"
	local block_name="$3"
	local idx kind name

	for ((idx = start_idx + 1; idx < ${#_lines[@]}; idx++)); do
		if cutpaste_parse_separator "${_lines[$idx]}" kind name && [ "$kind" = "END" ] && [ "$name" = "$block_name" ]; then
			printf '%s\n' "$idx"
			return 0
		fi
	done

	return 1
}

cutpaste_list() {
	local path="$1"
	shift
	local patterns=("$@")
	local lines=()
	if ! cutpaste_read_lines "$path" lines; then
		cutpaste_fail "cutpaste: cannot read '$path'"
	fi

	declare -A seen=()
	local idx kind name end_idx
	for ((idx = 0; idx < ${#lines[@]}; idx++)); do
		if cutpaste_parse_separator "${lines[$idx]}" kind name && [ "$kind" = "START" ]; then
			if ! end_idx="$(cutpaste_find_block_end lines "$idx" "$name")"; then
				continue
			fi
			if ! cutpaste_blockish_match "$name" "${patterns[@]}"; then
				continue
			fi
			if [ -z "${seen[$name]+x}" ]; then
				seen["$name"]=1
				printf '%s\n' "$name"
			fi
			idx="$end_idx"
		fi
	done
}

cutpaste_get() {
	local path="$1"
	local block="$2"
	local lines=()
	if ! cutpaste_read_lines "$path" lines; then
		cutpaste_fail "cutpaste: cannot read '$path'"
	fi

	local idx kind name end_idx
	for ((idx = 0; idx < ${#lines[@]}; idx++)); do
		if cutpaste_parse_separator "${lines[$idx]}" kind name && [ "$kind" = "START" ] && [ "$name" = "$block" ]; then
			if ! end_idx="$(cutpaste_find_block_end lines "$idx" "$name")"; then
				break
			fi
			if (( end_idx > idx + 1 )); then
				printf '%s\n' "${lines[@]:idx+1:end_idx-idx-1}"
			fi
			return 0
		fi
	done

	cutpaste_fail "cutpaste: block not found: $block"
}

cutpaste_rewrite() {
	local path="$1"
	local mode="$2"
	local overwrite="$3"
	local dry="$4"
	shift 4
	local patterns=("$@")
	local lines=()
	if [ "$path" = "-" ]; then
		if ! cutpaste_read_lines "$path" lines; then
			cutpaste_fail "cutpaste: cannot read stdin"
		fi
	else
		if [ -e "$path" ]; then
			if ! cutpaste_read_lines "$path" lines; then
				cutpaste_fail "cutpaste: cannot read '$path'"
			fi
		fi
	fi

	local out=()
	local idx kind name end_idx
	for ((idx = 0; idx < ${#lines[@]}; idx++)); do
		if cutpaste_parse_separator "${lines[$idx]}" kind name && [ "$kind" = "START" ] && cutpaste_blockish_match "$name" "${patterns[@]}"; then
			if ! end_idx="$(cutpaste_find_block_end lines "$idx" "$name")"; then
				out+=("${lines[$idx]}")
				continue
			fi

			case "$mode" in
				cut)
					;;
				strip)
					out+=("${lines[$idx]}")
					out+=("${lines[$end_idx]}")
					;;
				set)
					out+=("${lines[$idx]}")
					if [ "${#CUTPASTE_VALUE_LINES[@]}" -gt 0 ]; then
						out+=("${CUTPASTE_VALUE_LINES[@]}")
					fi
					out+=("${lines[$end_idx]}")
					;;
				*)
					cutpaste_fail "cutpaste: internal mode error"
					;;
			esac
			idx="$end_idx"
			continue
		fi

		out+=("${lines[$idx]}")
	done

	if [ "$mode" = "set" ] && [ "${CUTPASTE_BLOCK_FOUND:-0}" = "0" ]; then
		out+=("${CUTPASTE_NEW_START}")
		if [ "${#CUTPASTE_VALUE_LINES[@]}" -gt 0 ]; then
			out+=("${CUTPASTE_VALUE_LINES[@]}")
		fi
		out+=("${CUTPASTE_NEW_END}")
	fi

	local original_file result_file
	original_file="$(mktemp)"
	result_file="$(mktemp)"
	cutpaste_lines_to_text lines >"$original_file"
	cutpaste_lines_to_text out >"$result_file"

	if [ "$dry" = "1" ]; then
		cutpaste_show_diff "$path" "$original_file" "$result_file"
	elif [ "$overwrite" = "1" ]; then
		cutpaste_write_overwrite "$path" "$result_file"
	else
		cat "$result_file"
	fi

	rm -f "$original_file" "$result_file"
}

cutpaste_set() {
	local path="$1"
	local block="$2"
	local value="${3:-}"
	local overwrite="$4"
	local dry="$5"
	local lines=()

	if [ "$path" = "-" ]; then
		if ! cutpaste_read_lines "$path" lines; then
			cutpaste_fail "cutpaste: cannot read stdin"
		fi
	elif [ -e "$path" ]; then
		if ! cutpaste_read_lines "$path" lines; then
			cutpaste_fail "cutpaste: cannot read '$path'"
		fi
	fi

	cutpaste_read_value_lines "$value" CUTPASTE_VALUE_LINES
	CUTPASTE_BLOCK_FOUND=0
	CUTPASTE_NEW_START="$CUTPASTE_SEP START:$block"
	CUTPASTE_NEW_END="$CUTPASTE_SEP END:$block"

	local out=()
	local idx kind name end_idx
	for ((idx = 0; idx < ${#lines[@]}; idx++)); do
		if cutpaste_parse_separator "${lines[$idx]}" kind name && [ "$kind" = "START" ] && [ "$name" = "$block" ]; then
			if ! end_idx="$(cutpaste_find_block_end lines "$idx" "$name")"; then
				out+=("${lines[$idx]}")
				continue
			fi
			CUTPASTE_BLOCK_FOUND=1
			out+=("${lines[$idx]}")
			if [ "${#CUTPASTE_VALUE_LINES[@]}" -gt 0 ]; then
				out+=("${CUTPASTE_VALUE_LINES[@]}")
			fi
			out+=("${lines[$end_idx]}")
			idx="$end_idx"
			continue
		fi
		out+=("${lines[$idx]}")
	done

	if [ "$CUTPASTE_BLOCK_FOUND" = "0" ]; then
		out+=("$CUTPASTE_NEW_START")
		if [ "${#CUTPASTE_VALUE_LINES[@]}" -gt 0 ]; then
			out+=("${CUTPASTE_VALUE_LINES[@]}")
		fi
		out+=("$CUTPASTE_NEW_END")
	fi

	local original_file result_file
	original_file="$(mktemp)"
	result_file="$(mktemp)"
	cutpaste_lines_to_text lines >"$original_file"
	cutpaste_lines_to_text out >"$result_file"

	if [ "$dry" = "1" ]; then
		cutpaste_show_diff "$path" "$original_file" "$result_file"
	elif [ "$overwrite" = "1" ]; then
		cutpaste_write_overwrite "$path" "$result_file"
	else
		cat "$result_file"
	fi

	rm -f "$original_file" "$result_file"
}

main() {
	local cmd="${1:-}"
	shift || true

	case "$cmd" in
		-h|--help|help|"")
			cutpaste_usage
			;;
		--version|version)
			printf 'cutpaste %s\n' "$CUTPASTE_VERSION"
			;;
		list)
			[ "$#" -ge 1 ] || cutpaste_fail "cutpaste: list requires PATH"
			local path="$1"
			shift
			cutpaste_list "$path" "$@"
			;;
		get)
			[ "$#" -eq 2 ] || cutpaste_fail "cutpaste: get requires PATH and BLOCK"
			cutpaste_get "$1" "$2"
			;;
		set)
			local overwrite="0"
			local dry="0"
			while [ "$#" -gt 0 ]; do
				case "$1" in
					-w|--overwrite) overwrite="1"; shift ;;
					-d|--dry) dry="1"; shift ;;
					-h|--help)
						cutpaste_usage
						return 0
						;;
					--) shift; break ;;
					-) break ;;
					-*)
						cutpaste_fail "cutpaste: unknown option for set: $1"
						;;
					*)
						break
						;;
				esac
			done
			[ "$#" -ge 2 ] || cutpaste_fail "cutpaste: set requires PATH and BLOCK"
			local path="$1"
			local block="$2"
			shift 2
			local value=""
			if [ "$path" = "-" ] && [ "$#" -eq 0 ]; then
				cutpaste_fail "cutpaste: set with PATH='-' requires VALUE as an argument"
			fi
			if [ "$#" -gt 0 ]; then
				value="$1"
			else
				value="$(cat)"
			fi
			cutpaste_set "$path" "$block" "$value" "$overwrite" "$dry"
			;;
		cut)
			local overwrite="0"
			local dry="0"
			while [ "$#" -gt 0 ]; do
				case "$1" in
					-w|--overwrite) overwrite="1"; shift ;;
					-d|--dry) dry="1"; shift ;;
					-h|--help)
						cutpaste_usage
						return 0
						;;
					--) shift; break ;;
					-) break ;;
					-*)
						cutpaste_fail "cutpaste: unknown option for cut: $1"
						;;
					*)
						break
						;;
				esac
			done
			[ "$#" -ge 1 ] || cutpaste_fail "cutpaste: cut requires PATH"
			local path="$1"
			shift
			cutpaste_rewrite "$path" cut "$overwrite" "$dry" "$@"
			;;
		strip)
			local overwrite="0"
			local dry="0"
			while [ "$#" -gt 0 ]; do
				case "$1" in
					-w|--overwrite) overwrite="1"; shift ;;
					-d|--dry) dry="1"; shift ;;
					-h|--help)
						cutpaste_usage
						return 0
						;;
					--) shift; break ;;
					-) break ;;
					-*)
						cutpaste_fail "cutpaste: unknown option for strip: $1"
						;;
					*)
						break
						;;
				esac
			done
			[ "$#" -ge 1 ] || cutpaste_fail "cutpaste: strip requires PATH"
			local path="$1"
			shift
			cutpaste_rewrite "$path" strip "$overwrite" "$dry" "$@"
			;;
		*)
			cutpaste_usage >&2
			exit 1
			;;
	esac
}

main "$@"
